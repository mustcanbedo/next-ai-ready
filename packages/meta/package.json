{
  "name": "next-ai-ready",
  "version": "0.1.0-alpha.14",
  "description": "AEO + Agent-API layer for Next.js. Make your site readable by AI and callable by agents.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./actions": {
      "types": "./dist/actions.d.ts",
      "import": "./dist/actions.js"
    },
    "./config": {
      "types": "./dist/config.d.ts",
      "import": "./dist/config.js",
      "require": "./dist/config.cjs"
    },
    "./json-ld": {
      "types": "./dist/json-ld.d.ts",
      "import": "./dist/json-ld.js"
    },
    "./robots": {
      "types": "./dist/robots.d.ts",
      "import": "./dist/robots.js"
    },
    "./audit": {
      "types": "./dist/audit.d.ts",
      "import": "./dist/audit.js"
    },
    "./handlers/llms-txt": {
      "types": "./dist/handlers/llms-txt.d.ts",
      "import": "./dist/handlers/llms-txt.js"
    },
    "./handlers/llms-full": {
      "types": "./dist/handlers/llms-full.d.ts",
      "import": "./dist/handlers/llms-full.js"
    },
    "./handlers/page-md": {
      "types": "./dist/handlers/page-md.d.ts",
      "import": "./dist/handlers/page-md.js"
    },
    "./handlers/page-ai-json": {
      "types": "./dist/handlers/page-ai-json.d.ts",
      "import": "./dist/handlers/page-ai-json.js"
    },
    "./handlers/openapi": {
      "types": "./dist/handlers/openapi.d.ts",
      "import": "./dist/handlers/openapi.js"
    },
    "./handlers/tools": {
      "types": "./dist/handlers/tools.d.ts",
      "import": "./dist/handlers/tools.js"
    },
    "./handlers/action": {
      "types": "./dist/handlers/action.d.ts",
      "import": "./dist/handlers/action.js"
    },
    "./handlers/mcp": {
      "types": "./dist/handlers/mcp.d.ts",
      "import": "./dist/handlers/mcp.js"
    },
    "./handlers/ai-plugin": {
      "types": "./dist/handlers/ai-plugin.d.ts",
      "import": "./dist/handlers/ai-plugin.js"
    },
    "./hooks": {
      "types": "./dist/hooks.d.ts",
      "import": "./dist/hooks.js"
    }
  },
  "bin": {
    "next-ai-ready": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "clean": "rm -rf dist .turbo"
  },
  "dependencies": {
    "@next-ai-ready/core": "workspace:*",
    "@next-ai-ready/semantic": "workspace:*",
    "@next-ai-ready/mdx": "workspace:*",
    "@next-ai-ready/actions": "workspace:*",
    "@next-ai-ready/llms": "workspace:*",
    "@next-ai-ready/openapi": "workspace:*",
    "@next-ai-ready/mcp": "workspace:*",
    "@next-ai-ready/next": "workspace:*"
  },
  "devDependencies": {
    "tsup": "^8.3.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.9"
  }
}
