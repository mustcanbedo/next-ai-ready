{
  "name": "@next-ai-ready/semantic",
  "version": "0.1.0-alpha.13",
  "description": "SemanticGraph builder + JSON-LD emitter.",
  "keywords": [
    "nextjs",
    "aeo",
    "json-ld",
    "semantic-web",
    "structured-data"
  ],
  "homepage": "https://next-ai-ready.vercel.app/en",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mustcanbedo/next-ai-ready.git",
    "directory": "packages/semantic"
  },
  "bugs": {
    "url": "https://github.com/mustcanbedo/next-ai-ready/issues"
  },
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./jsonld": {
      "types": "./dist/jsonld.d.ts",
      "import": "./dist/jsonld.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "clean": "rm -rf dist .turbo"
  },
  "dependencies": {
    "@next-ai-ready/core": "workspace:*"
  },
  "devDependencies": {
    "tsup": "^8.3.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
