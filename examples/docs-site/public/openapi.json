    "/api/actions/search_docs": {
      "post": {
        "description": "When the user asks about a topic and you need to find relevant documentation pages.",
        "operationId": "search_docs",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "additionalProperties": false,
                "properties": {
                  "limit": {
                    "description": "Max results to return (default 5)",
                    "maximum": 20,
                    "minimum": 1,
                    "type": "integer"
                  },
                  "query": {
                    "description": "Search keyword or phrase",
                    "minLength": 1,
                    "type": "string"
                  }
                },
                "required": [
                  "query"
                ],
                "type": "object"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": false,
                  "properties": {
                    "results": {
                      "items": {
                        "additionalProperties": false,
                        "properties": {
                          "route": {
                            "type": "string"
                          },
                          "section": {
                            "type": "string"
                          },
                          "summary": {
                            "type": "string"
                          },
                          "title": {
                            "type": "string"
                          }
                        },
                        "required": [
                          "route",
                          "title",
                          "summary",
                          "section"
                        ],
                        "type": "object"
                      },
                      "type": "array"
                    },
                    "total": {
                      "type": "number"
                    }
                  },
                  "required": [
                    "results",
                    "total"
                  ],
                  "type": "object"
                }
              }
            },
