              "application/json": {
                "schema": {
                  "properties": {
                    "code": {
                      "type": "string"
                    },
                    "details": {},
                    "message": {
                      "type": "string"
                    },
                    "ok": {
                      "const": false,
                      "type": "boolean"
                    }
